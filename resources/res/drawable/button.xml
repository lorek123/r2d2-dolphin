<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:constantSize="true">
    <item
        android:state_enabled="true"
        android:state_pressed="false">
        <shape>
            <gradient
                android:startColor="#ffd6d3d6"
                android:endColor="#ffd6d3d6"
                android:angle="90"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#fff4e752"
                android:endColor="#fff4e752"
                android:angle="90"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <gradient
                android:startColor="#fff4e752"
                android:endColor="#fff4e752"
                android:angle="90"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#ffd6d3d6"
                android:endColor="#ffd6d3d6"
                android:angle="90"/>
        </shape>
    </item>
</selector>
